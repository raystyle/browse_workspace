// download mech:CDP 操作下载文件(引擎会话与指纹,墙友好;aria2 弃用)。
// 用法:browse rune page-skills/download/mech.rn --vars url=<直链> --vars dest=<下载目录绝对路径> [--timeout 900]
// 产出:{"slug":"download","verdict":"ok|challenge|inline|timeout|net|denied","url":..,"path":..,"name":..,"message":..}
// 流(双段,2026-10-20 实弹定稿):
//   段一 goto 源根 → 挑战检测看本页 DOM → 页内 <a download> 锚点点击
//        (同源锚点 download 属性被浏览器尊重:PDF 查看器、文本直显
//        一律强制转下载;这是内联型的唯一通路)
//   段二 goto 目标 URL 直航(content-disposition 附件导航自动转下载,
//        跨域锚点 download 属性失效后的兜底,github release 资产类)
//   两段都无 downloadWillBegin → verdict=inline,Python 侧改走 fetch 面。
// 陷阱(workspace 记档,实弹教训):
//   - 页内 fetch 探体对 302 跨域资产必挂 TypeError(CORS),不能当拒载
//   - 锚点跨域终链 download 属性失效(实测静默无事件)
//   - suggestedFilename 给真名;Rune 字符串面只有 contains,名字解析
//     下放 Python(message 携 begin 事件原文)
//   - 进度循环每轮事件成功也累计耗时:只数空等会让事件流不断的下载
//     永不超时
pub async fn main() {
    let url = "<%= url | default("") %>";
    let dest = "<%= dest | default("C:/Users/ray/.browse-rs/drops") %>";
    let tmo = <%= timeout | default(900) %>;
    fn esc(s) {
        return s.replace("\r", " ").replace("\n", " ").replace("\\", "\\\\").replace("\"", "\\\"");
    }
    fn receipt(verdict, url, dest, name, msg) {
        return "{\"slug\":\"download\",\"verdict\":\"" + verdict + "\",\"url\":\"" + esc(url)
            + "\",\"path\":\"" + esc(dest) + "/" + esc(name) + "\",\"name\":\"" + esc(name)
            + "\",\"message\":\"" + esc(msg) + "\"}";
    }
    if url == "" {
        return Ok(receipt("denied", url, dest, "", "url 变量缺失"));
    }
    let _ = cdp::raw("Browser.setDownloadBehavior",
        "{\"behavior\":\"allow\",\"downloadPath\":\"" + dest + "\",\"eventsEnabled\":true}").await;
    // 源根导航(同源化:锚点在源根页内才有同源属性)
    let origin = match cdp::js(r#"function org(args) {
  try { return new URL(args.u).origin; } catch (e) { return args.u; }
}
return org(args);"#, #{"u" : url}).await {
        Ok(v) => v,
        Err(_) => url,
    };
    let _nav = cdp::goto(origin).await;
    time::sleep(time::Duration::from_millis(1000)).await;
    // 挑战检测:看源根渲染出的本页 DOM(用户令:撞挑战要告警停住)
    let page_chk = match cdp::js(r#"function chk(args) {
  var t = (document.title || "") + " " + (document.body ? document.body.innerText.slice(0, 800) : "");
  var low = t.toLowerCase();
  var ch = low.indexOf("just a moment") >= 0 || low.indexOf("verify you are human") >= 0
    || low.indexOf("security verification") >= 0 || low.indexOf("cf-chl") >= 0;
  return JSON.stringify({challenge: ch ? 1 : 0, title: document.title || ""});
}
return chk(args);"#, #{"u" : url}).await {
        Ok(v) => v,
        Err(e) => { return Ok(receipt("net", url, dest, "", e.message)); }
    };
    if page_chk.contains("\"challenge\":1") {
        return Ok(receipt("challenge", url, dest, "", "源页撞挑战:" + page_chk));
    }
    // 段一:同源锚点(治内联型:PDF 查看器/文本直显强制转下载)
    let _click = cdp::js(r#"function go(args) {
  var HASH = String.fromCharCode(35);
  var name = args.url.split("?")[0].split(HASH)[0].split("/").pop() || "file.bin";
  var a = document.createElement("a");
  a.href = args.url; a.download = name; a.rel = "noopener";
  document.body.appendChild(a); a.click();
  a.remove();
  return "clicked";
}
return go(args);"#, #{"url" : url}).await;
    let began = cdp::wait_event("Browser.downloadWillBegin", 15).await;
    // 段二:直航兜底(治跨域附件:锚点属性失效,导航转下载)
    if began.is_err() {
        let _nav2 = cdp::goto(url).await;
        time::sleep(time::Duration::from_millis(800)).await;
        began = cdp::wait_event("Browser.downloadWillBegin", 15).await;
    }
    let (began_dbg, name) = match began {
        Ok(ev) => {
            let d = format!("{:?}", ev);
            // Rune 字符串面只有 contains:名字解析下放 Python 侧
            (d, "")
        }
        Err(_) => { return Ok(receipt("inline", url, dest, "", "无 downloadWillBegin(内联型,改走 fetch 面)")); }
    };
    // 循环等完成:每轮事件成功也累计耗时(只数空等 = 事件流不断时
    // 永不超时的死循环;归档服务器慢速常见,tmo 放宽)
    let waited = 0;
    while waited < tmo {
        let ev = cdp::wait_event("Browser.downloadProgress", 30).await;
        match ev {
            Ok(e) => {
                let s = format!("{:?}", e);
                if s.contains("completed") {
                    return Ok(receipt("ok", url, dest, name, began_dbg));
                }
                waited = waited + 1;
            }
            Err(_) => { waited = waited + 30; }
        }
    }
    return Ok(receipt("timeout", url, dest, name, began_dbg));
}
